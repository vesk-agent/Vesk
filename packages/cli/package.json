{
  "name": "vesk-agent",
  "version": "0.1.0",
  "description": "Vesk CLI: an open-source AI agent for memecoin trading and launching on Solana.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "vesk": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vesk-agent/vesk.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo no tests"
  },
  "dependencies": {
    "@vesk-agent/core": "workspace:*",
    "@vesk-agent/mcp": "workspace:*",
    "@vesk-agent/telegram": "workspace:*",
    "yaml": "2.6.1"
  }
}
